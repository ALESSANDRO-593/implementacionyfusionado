                      "parameters":  {
                                         "jsCode":  "const crypto=require(\u0027crypto\u0027);const fail=(statusCode,error)=\u003e[{json:{ok:false,statusCode,error}}];const authorization=$json.headers?.authorization??\u0027\u0027;if(!authorization.startsWith(\u0027Bearer \u0027))return fail(401,\u0027Sesión requerida.\u0027);const secret=$env.JWT_SECRET;if(!secret)return fail(500,\u0027JWT_SECRET no está configurado.\u0027);try{const[h,p,s,x]=authorization.slice(7).trim().split(\u0027.\u0027);if(!h||!p||!s||x)throw new Error();const expected=crypto.createHmac(\u0027sha256\u0027,secret).update(`${h}.${p}`).digest(\u0027base64url\u0027),left=Buffer.from(s),right=Buffer.from(expected);if(left.length!==right.length||!crypto.timingSafeEqual(left,right))throw new Error();const payload=JSON.parse(Buffer.from(p,\u0027base64url\u0027).toString(\u0027utf8\u0027));if(!payload.exp||payload.exp\u003c=Math.floor(Date.now()/1000))throw new Error();const role=String(payload.rol??payload.role??\u0027\u0027).toUpperCase(),permissions=(Array.isArray(payload.permisos)?payload.permisos:[]).map(v=\u003eString(v).toLowerCase());if(role!==\u0027ADMINISTRADOR_PARKING\u0027\u0026\u0026!permissions.includes(\u0027parqueadero.gestionar\u0027))return fail(403,\u0027No tiene permisos para gestionar parqueadero.\u0027);const id=Number($json.body?.id),startDate=String($json.body?.startDate??\u0027\u0027);if(!Number.isInteger(id)||id\u003c=0)return fail(400,\u0027El pago seleccionado no es válido.\u0027);if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(startDate)||Number.isNaN(Date.parse(`${startDate}T00:00:00Z`)))return fail(400,\u0027Seleccione una fecha de vigencia válida.\u0027);return[{json:{ok:true,id,startDate}}];}catch{return fail(401,\u0027La sesión es inválida o ha vencido.\u0027);}"
                                     },
