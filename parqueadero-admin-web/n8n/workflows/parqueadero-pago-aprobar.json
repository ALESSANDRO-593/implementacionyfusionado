                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH target AS MATERIALIZED (\n  SELECT pp.id, pp.parqueadero_usuario_id, pm.modalidad\n  FROM public.parqueadero_pagos pp\n  JOIN public.parqueadero_modalidades pm ON pm.id = pp.modalidad_id\n  JOIN public.parqueadero_usuarios pu ON pu.id = pp.parqueadero_usuario_id AND pu.estado = \u0027ACTIVO\u0027\n  WHERE pp.id = $1::bigint AND pp.estado = \u0027PENDIENTE\u0027\n    AND NOT EXISTS (SELECT 1 FROM public.parqueadero_autorizaciones pa WHERE pa.pago_id = pp.id)\n  FOR UPDATE OF pp\n), updated_payment AS (\n  UPDATE public.parqueadero_pagos pp\n  SET estado = \u0027APROBADO\u0027, fecha_pago = now(), fecha_inicio = $2::date,\n      fecha_fin = CASE WHEN t.modalidad = \u0027MENSUAL\u0027 THEN CASE WHEN EXTRACT(DAY FROM $2::date) = 1 THEN (date_trunc(\u0027month\u0027, $2::date) + INTERVAL \u00271 month - 1 day\u0027)::date ELSE ($2::date + INTERVAL \u00271 month\u0027)::date END ELSE $2::date END\n  FROM target t WHERE pp.id = t.id\n  RETURNING pp.id, pp.parqueadero_usuario_id, pp.fecha_inicio, pp.fecha_fin\n), inserted_authorization AS (\n  INSERT INTO public.parqueadero_autorizaciones (parqueadero_usuario_id, pago_id, fecha_inicio, fecha_fin, estado)\n  SELECT parqueadero_usuario_id, id, fecha_inicio, fecha_fin, \u0027VIGENTE\u0027 FROM updated_payment\n  RETURNING id\n)\nSELECT\n  EXISTS(SELECT 1 FROM inserted_authorization) AS success,\n  (SELECT id::int FROM updated_payment) AS id,\n  (SELECT id::int FROM inserted_authorization) AS \"authorizationId\",\n  CASE WHEN NOT EXISTS(SELECT 1 FROM target) THEN \u0027El pago no existe, ya fue procesado, tiene un ticket o el usuario está inhabilitado.\u0027 END AS error,\n  CASE WHEN NOT EXISTS(SELECT 1 FROM target) THEN 409 ELSE 200 END AS \"statusCode\";",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$json.id, $json.startDate] }}"
                                                     }
                                     },
