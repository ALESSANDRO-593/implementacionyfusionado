                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH eligible AS (\n  SELECT pu.id AS user_id, pv.tipo_vehiculo\n  FROM public.parqueadero_usuarios pu\n  JOIN public.parqueadero_vehiculos pv ON pv.id = $2::bigint\n    AND pv.parqueadero_usuario_id = pu.id\n    AND pv.activo = TRUE\n  WHERE pu.id = $1::bigint AND pu.estado = \u0027ACTIVO\u0027 AND pu.tipo_usuario = \u0027INVITADO\u0027\n), configured_modality AS (\n  SELECT pm.id, pm.modalidad, pm.precio\n  FROM public.parqueadero_modalidades pm\n  JOIN eligible e ON e.tipo_vehiculo = pm.tipo_vehiculo\n  WHERE pm.modalidad = $3 AND pm.activo = TRUE AND pm.precio IS NOT NULL\n), inserted_payment AS (\n  INSERT INTO public.parqueadero_pagos (\n    parqueadero_usuario_id, modalidad_id, monto, metodo_pago, referencia, fecha_pago,\n    fecha_inicio, fecha_fin, estado, registrado_por\n  )\n  SELECT\n    e.user_id, cm.id, cm.precio, $5, NULLIF($6, \u0027\u0027), now(), $4::date,\n    CASE WHEN cm.modalidad = \u0027MENSUAL\u0027 THEN CASE WHEN EXTRACT(DAY FROM $4::date) = 1 THEN (date_trunc(\u0027month\u0027, $4::date) + INTERVAL \u00271 month - 1 day\u0027)::date ELSE ($4::date + INTERVAL \u00271 month\u0027)::date END ELSE $4::date END,\n    $7, $9::bigint\n  FROM eligible e\n  CROSS JOIN configured_modality cm\n  RETURNING id, parqueadero_usuario_id, fecha_inicio, fecha_fin, estado, monto\n), inserted_authorization AS (\n  INSERT INTO public.parqueadero_autorizaciones (parqueadero_usuario_id, pago_id, fecha_inicio, fecha_fin, estado)\n  SELECT parqueadero_usuario_id, id, fecha_inicio, fecha_fin, \u0027VIGENTE\u0027\n  FROM inserted_payment\n  WHERE estado = \u0027APROBADO\u0027 AND $8::boolean = TRUE\n  RETURNING id, codigo\n)\nSELECT\n  COALESCE((SELECT TRUE FROM inserted_payment LIMIT 1), FALSE) AS success,\n  (SELECT id::int FROM inserted_payment LIMIT 1) AS id,\n  (SELECT monto::double precision FROM inserted_payment LIMIT 1) AS amount,\n  (SELECT id::int FROM inserted_authorization LIMIT 1) AS \"authorizationId\",\n  (SELECT codigo::text FROM inserted_authorization LIMIT 1) AS \"authorizationCode\",\n  CASE\n    WHEN NOT EXISTS (SELECT 1 FROM eligible) THEN \u0027El usuario o vehículo no existe, está inactivo o no corresponde al usuario.\u0027\n    WHEN NOT EXISTS (SELECT 1 FROM configured_modality) THEN \u0027No existe una tarifa activa para esta modalidad y tipo de vehículo.\u0027\n    ELSE NULL\n  END AS error,\n  CASE\n    WHEN NOT EXISTS (SELECT 1 FROM eligible) THEN 404\n    WHEN NOT EXISTS (SELECT 1 FROM configured_modality) THEN 409\n    ELSE 201\n  END AS \"statusCode\";",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$json.parkingUserId, $json.vehicleId, $json.modality, $json.startDate, $json.method, $json.reference, $json.status, $json.issueAuthorization, $json.panelUserId] }}"
                                                     }
                                     },
