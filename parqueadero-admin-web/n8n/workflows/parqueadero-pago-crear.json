                  {
                      "parameters":  {
                                         "jsCode":  "const crypto=require(\u0027crypto\u0027); const fail=(statusCode,error)=\u003e[{json:{ok:false,statusCode,error}}]; const authorization=$json.headers?.authorization??\u0027\u0027; if(!authorization.startsWith(\u0027Bearer \u0027)) return fail(401,\u0027Sesión requerida.\u0027); const secret=$env.JWT_SECRET; if(!secret) return fail(500,\u0027JWT_SECRET no está configurado.\u0027);\ntry {\n const token=authorization.slice(7).trim(); const [h,p,s,x]=token.split(\u0027.\u0027); if(!h||!p||!s||x) throw new Error(); const expected=crypto.createHmac(\u0027sha256\u0027,secret).update(`${h}.${p}`).digest(\u0027base64url\u0027); const left=Buffer.from(s),right=Buffer.from(expected); if(left.length!==right.length||!crypto.timingSafeEqual(left,right)) throw new Error(); const payload=JSON.parse(Buffer.from(p,\u0027base64url\u0027).toString(\u0027utf8\u0027)); if(!payload.exp||payload.exp\u003c=Math.floor(Date.now()/1000)) throw new Error(); const role=String(payload.rol??payload.role??\u0027\u0027).toUpperCase(); const permissions=(Array.isArray(payload.permisos)?payload.permisos:[]).map(v=\u003eString(v).toLowerCase()); if(role!==\u0027ADMINISTRADOR_PARKING\u0027\u0026\u0026!permissions.includes(\u0027parqueadero.gestionar\u0027)) return fail(403,\u0027No tiene permisos para gestionar parqueadero.\u0027);\n const body=$json.body??{}; const parkingUserId=Number(body.parkingUserId); const vehicleId=Number(body.vehicleId); const modality=String(body.modality??\u0027\u0027).toUpperCase(); const startDate=String(body.startDate??\u0027\u0027); const method=String(body.method??\u0027\u0027).toUpperCase(); const status=String(body.status??\u0027\u0027).toUpperCase(); const issueAuthorization=body.issueAuthorization===true \u0026\u0026 status===\u0027APROBADO\u0027; const reference=method===\u0027TRANSFERENCIA\u0027?String(body.reference??\u0027\u0027).trim():null; const panelUserId=Number(payload.uid??payload.sub);\n if(!Number.isInteger(parkingUserId)||parkingUserId\u003c=0||!Number.isInteger(vehicleId)||vehicleId\u003c=0) return fail(400,\u0027Seleccione un usuario y vehículo válidos.\u0027); if(![\u0027DIARIO\u0027,\u0027MENSUAL\u0027].includes(modality)) return fail(400,\u0027Seleccione una modalidad válida.\u0027); if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(startDate)||Number.isNaN(Date.parse(`${startDate}T00:00:00Z`))) return fail(400,\u0027Seleccione una fecha válida.\u0027); if(![\u0027EFECTIVO\u0027,\u0027TRANSFERENCIA\u0027].includes(method)) return fail(400,\u0027Seleccione una forma de pago válida.\u0027); if(![\u0027PENDIENTE\u0027,\u0027APROBADO\u0027].includes(status)) return fail(400,\u0027Seleccione un estado de pago válido.\u0027); if(method===\u0027TRANSFERENCIA\u0027\u0026\u0026(!reference||reference.length\u003e120)) return fail(400,\u0027Ingrese una referencia de transferencia válida.\u0027); if(!Number.isInteger(panelUserId)||panelUserId\u003c=0) return fail(401,\u0027La sesión no identifica al usuario del panel.\u0027);\n return [{json:{ok:true,parkingUserId,vehicleId,modality,startDate,method,reference,status,issueAuthorization,panelUserId}}];\n} catch { return fail(401,\u0027La sesión es inválida o ha vencido.\u0027); }"
                                     },
