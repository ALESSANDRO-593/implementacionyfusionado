                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH eligible_user AS (\n  SELECT id\n  FROM public.parqueadero_usuarios\n  WHERE id = $1::bigint AND estado = \u0027ACTIVO\u0027 AND tipo_usuario = \u0027INVITADO\u0027\n), plate_conflict AS (\n  SELECT id\n  FROM public.parqueadero_vehiculos\n  WHERE UPPER(placa) = UPPER($2)\n), primary_choice AS (\n  SELECT CASE\n    WHEN NOT EXISTS (\n      SELECT 1 FROM public.parqueadero_vehiculos pv\n      WHERE pv.parqueadero_usuario_id = $1::bigint AND pv.activo = TRUE\n    ) THEN TRUE\n    ELSE $7::boolean\n  END AS is_primary\n), demoted AS (\n  UPDATE public.parqueadero_vehiculos pv\n  SET es_principal = FALSE, actualizado_en = now()\n  WHERE pv.parqueadero_usuario_id = $1::bigint\n    AND pv.activo = TRUE\n    AND pv.es_principal = TRUE\n    AND (SELECT is_primary FROM primary_choice) = TRUE\n    AND EXISTS (SELECT 1 FROM eligible_user)\n    AND NOT EXISTS (SELECT 1 FROM plate_conflict)\n  RETURNING pv.id\n), inserted AS (\n  INSERT INTO public.parqueadero_vehiculos (\n    parqueadero_usuario_id, placa, tipo_vehiculo, marca, modelo, color, es_principal, activo\n  )\n  SELECT eu.id, UPPER($2), $3, $4, $5, $6, pc.is_primary, TRUE\n  FROM eligible_user eu\n  CROSS JOIN primary_choice pc\n  CROSS JOIN (SELECT count(*) FROM demoted) dependency\n  WHERE NOT EXISTS (SELECT 1 FROM plate_conflict)\n  RETURNING id, es_principal\n)\nSELECT\n  COALESCE((SELECT TRUE FROM inserted LIMIT 1), FALSE) AS success,\n  (SELECT id::int FROM inserted LIMIT 1) AS id,\n  (SELECT es_principal FROM inserted LIMIT 1) AS \"isPrimary\",\n  CASE\n    WHEN NOT EXISTS (SELECT 1 FROM eligible_user) THEN \u0027El usuario no existe, está inhabilitado o no es invitado.\u0027\n    WHEN EXISTS (SELECT 1 FROM plate_conflict) THEN \u0027La placa ingresada ya está registrada.\u0027\n    ELSE NULL\n  END AS error,\n  CASE\n    WHEN NOT EXISTS (SELECT 1 FROM eligible_user) THEN 404\n    WHEN EXISTS (SELECT 1 FROM plate_conflict) THEN 409\n    ELSE 201\n  END AS \"statusCode\";",
