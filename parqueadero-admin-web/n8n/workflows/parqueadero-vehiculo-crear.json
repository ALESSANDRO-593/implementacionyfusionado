                  {
                      "parameters":  {
                                         "jsCode":  "const crypto = require(\u0027crypto\u0027);\nconst fail = (statusCode, error) =\u003e [{ json: { ok: false, statusCode, error } }];\nconst authorization = $json.headers?.authorization ?? \u0027\u0027;\nif (!authorization.startsWith(\u0027Bearer \u0027)) return fail(401, \u0027Sesión requerida.\u0027);\nconst secret = $env.JWT_SECRET;\nif (!secret) return fail(500, \u0027JWT_SECRET no está configurado.\u0027);\ntry {\n  const token = authorization.slice(7).trim();\n  const [header, payloadPart, signature, extra] = token.split(\u0027.\u0027);\n  if (!header || !payloadPart || !signature || extra) throw new Error();\n  const expected = crypto.createHmac(\u0027sha256\u0027, secret).update(`${header}.${payloadPart}`).digest(\u0027base64url\u0027);\n  const left = Buffer.from(signature);\n  const right = Buffer.from(expected);\n  if (left.length !== right.length || !crypto.timingSafeEqual(left, right)) throw new Error();\n  const payload = JSON.parse(Buffer.from(payloadPart, \u0027base64url\u0027).toString(\u0027utf8\u0027));\n  if (!payload.exp || payload.exp \u003c= Math.floor(Date.now() / 1000)) throw new Error();\n  const role = String(payload.rol ?? payload.role ?? \u0027\u0027).toUpperCase();\n  const permissions = (Array.isArray(payload.permisos) ? payload.permisos : []).map(value =\u003e String(value).toLowerCase());\n  if (role !== \u0027ADMINISTRADOR_PARKING\u0027 \u0026\u0026 !permissions.includes(\u0027parqueadero.gestionar\u0027)) return fail(403, \u0027No tiene permisos para gestionar parqueadero.\u0027);\n\n  const body = $json.body ?? {};\n  const parkingUserId = Number(body.parkingUserId);\n  const plate = String(body.plate ?? \u0027\u0027).trim().toUpperCase().replace(/\\s+/g, \u0027\u0027);\n  const type = String(body.type ?? \u0027\u0027).toUpperCase();\n  const brand = null;\n  const model = null;\n  const color = null;\n  const isPrimary = true;\n  if (!Number.isInteger(parkingUserId) || parkingUserId \u003c= 0) return fail(400, \u0027Seleccione un usuario válido.\u0027);\n  if (!/^[A-Z0-9-]{5,15}$/.test(plate)) return fail(400, \u0027Ingrese una placa válida.\u0027);\n  if (![\u0027AUTO\u0027, \u0027MOTO\u0027].includes(type)) return fail(400, \u0027Seleccione un tipo de vehículo válido.\u0027);\n  return [{ json: { ok: true, parkingUserId, plate, type, brand, model, color, isPrimary } }];\n} catch {\n  return fail(401, \u0027La sesión es inválida o ha vencido.\u0027);\n}"
                                     },
