# =====================================================================
# YaviBot — Variables de entorno (copiar a .env y completar)
# El archivo .env NO se sube a Git (está en .gitignore).
# =====================================================================

# --- Envío de correos por SMTP (Gmail) -------------------------------
# 1) Activa la verificación en 2 pasos en tu cuenta Google.
# 2) Crea una "Contraseña de aplicación" (16 caracteres) en:
#    https://myaccount.google.com/apppasswords
# 3) Pega esa contraseña en SMTP_PASS (sin espacios) y tu correo en SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=tucorreo@gmail.com

# --- Sesión del chatbot y base de datos de la aplicación ----------------
# Genera CHAT_JWT_SECRET con al menos 32 bytes aleatorios y usa el mismo valor
# en toda instancia que emita o valide sesiones del chatbot.
CHAT_JWT_SECRET=reemplazar-con-secreto-aleatorio
# Secret Key de la misma clave reCAPTCHA v2 cuya Site Key usan ambos frontends.
RECAPTCHA_SECRET_KEY=reemplazar-con-secret-key-recaptcha
YAVIBOT_DB_HOST=postgres
YAVIBOT_DB_PORT=5432
YAVIBOT_DB_NAME=yavibot
YAVIBOT_DB_USER=yavibot
YAVIBOT_DB_PASSWORD=reemplazar-con-password-postgres

