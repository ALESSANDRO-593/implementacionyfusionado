                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH persona AS (\n  SELECT e.id AS persona_id, e.cedula, \u0027ESTUDIANTE\u0027::text AS tipo_usuario,\n         e.nombres, e.correo, e.estado_matricula,\n         e.nivel::text AS nivel, e.paralelo::text AS paralelo,\n         c.nombre::text AS carrera,\n         (SELECT nombre FROM periodos_academicos WHERE vigente = true ORDER BY id DESC LIMIT 1)::text AS periodo_actual\n  FROM estudiantes e\n  LEFT JOIN carreras c ON c.id = e.carrera_id\n  WHERE e.cedula = $1\n\n  UNION ALL\n\n  SELECT d.id AS persona_id, d.cedula, \u0027DOCENTE\u0027::text AS tipo_usuario,\n         d.nombre_docente AS nombres, d.correo,\n         NULL::text AS estado_matricula, NULL::text AS nivel,\n         NULL::text AS paralelo, NULL::text AS carrera,\n         NULL::text AS periodo_actual\n  FROM docentes d\n  WHERE d.cedula = $1\n    AND NOT EXISTS (SELECT 1 FROM estudiantes e WHERE e.cedula = $1)\n)\nSELECT * FROM persona LIMIT 1",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$(\u0027Webhook Iniciar\u0027).first().json.body.cedula] }}"
                                                     }
                                     },
                      "id":  "n_buscar",
                      "name":  "Buscar Usuario",
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.6,
                      "position":  [
                                       660,
                                       220
                                   ],
                      "alwaysOutputData":  true,
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "s0Gn0DbaHQtIzuTr",
                                                           "name":  "YaviBot Postgres"
                                                       }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const crypto = require(\u0027crypto\u0027);\nconst rows = $input.all().map(i =\u003e i.json).filter(r =\u003e r \u0026\u0026 r.persona_id);\nconst cedula = String($(\u0027Webhook Iniciar\u0027).first().json.body.cedula || \u0027\u0027).trim();\nif (!/^\\d{10}$/.test(cedula)) {\n  return [{ json: { acceso:false, mensaje:\u0027La cédula debe tener 10 dígitos.\u0027, cedula } }];\n}\nif (rows.length === 0) {\n  return [{ json: { acceso:false, mensaje:\u0027No encontramos un usuario con esa cédula.\u0027, cedula } }];\n}\nconst usuario = rows[0];\nif (usuario.tipo_usuario === \u0027ESTUDIANTE\u0027 \u0026\u0026 String(usuario.estado_matricula).toUpperCase() !== \u0027MATRICULADO\u0027) {\n  return [{ json: { acceso:false, mensaje:\u0027Estudiante no matriculado. No es posible acceder al sistema.\u0027, cedula } }];\n}\nconst otp = String(Math.floor(10000 + Math.random() * 90000));\nconst otp_hash = crypto.createHash(\u0027sha256\u0027).update(otp).digest(\u0027hex\u0027);\nconst expira_en = new Date(Date.now() + 5 * 60 * 1000).toISOString();\nreturn [{ json: {\n  acceso:true, cedula, tipoUsuario:usuario.tipo_usuario,\n  persona_id:usuario.persona_id, correo:usuario.correo,\n  nombres:usuario.nombres, otp, otp_hash, expira_en\n} }];"
                                     },
