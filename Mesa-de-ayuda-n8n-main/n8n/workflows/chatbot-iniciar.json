                  {
                      "parameters":  {
                                         "jsCode":  "const nodemailer = require(\u0027nodemailer\u0027);\nconst _rawtx = nodemailer.createTransport({ host: $env.SMTP_HOST, port: Number($env.SMTP_PORT||465), secure: String($env.SMTP_SECURE||\u0027true\u0027)!==\u0027false\u0027, auth: $env.SMTP_USER ? { user: $env.SMTP_USER, pass: $env.SMTP_PASS } : undefined, tls: { rejectUnauthorized: false } }); const tx = { sendMail: async (m) =\u003e { try { return await _rawtx.sendMail(m); } catch(e) { console.log(\u0027YaviBot: correo no enviado -\u0027, e.message); } } };\nconst d = $(\u0027Decidir\u0027).first().json;\nawait tx.sendMail({\n  from: ($env.SMTP_FROM || $env.SMTP_USER || \u0027no-reply@yavibot.local\u0027),\n  to: d.correo,\n  subject: \u0027Tu código de verificación YaviBot\u0027,\n  text: `Hola ${d.nombres},\\n\\nTu código de verificación es: ${d.otp}\\n\\nEs válido por 5 minutos y de un solo uso.\\n\\nInstituto Superior Tecnológico Yavirac`\n});\nreturn $input.all();"
                                     },
